local function ActionToggle(label,icon,yPos,colorOn,onToggle)
    local row=MakeFrame({Size=UDim2.new(1,-24,0,34),Position=UDim2.new(0,12,0,yPos),BackgroundColor3=C.Card},DupeContainer)
    Corner(row,4); Stroke(row,C.Border,1)
