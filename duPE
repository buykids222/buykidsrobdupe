local function cleanBodyForces(hrp)
    for _,inst in ipairs(hrp:GetChildren()) do
        if inst:IsA("BodyVelocity")
        or inst:IsA("BodyForce")
        or inst:IsA("BodyAngularVelocity")
        or inst:IsA("LinearVelocity")
        or inst:IsA("AngularVelocity") then
            inst:Destroy()
        end
    end
end

-- finds closest unoccupied car in workspace.CivCars
local function findBestCar(targetHRP)
    local civCars = workspace:FindFirstChild("CivCars")
    if not civCars then return nil end
    local best, bestDist = nil, math.huge
    for _,car in ipairs(civCars:GetChildren()) do
        local seat = car:FindFirstChild("DriveSeat")
        if seat and not seat.Occupant then
            local primary = car.PrimaryPart
                or (car:FindFirstChild("Body") and car:FindFirstChild("Body"):FindFirstChild("#Weight"))
                or car:FindFirstChildOfClass("BasePart")
            if primary then
                local dist = (primary.Position - targetHRP.Position).Magnitude
                if dist < bestDist then best=car; bestDist=dist end
            end
        end
    end
    return best
end

local function launchFling(targetHRP)
    cleanBodyForces(targetHRP)
    local angle = math.random(0, 359)
    local hx = math.cos(math.rad(angle)) * CAR_FLING_H_SPEED
    local hz = math.sin(math.rad(angle)) * CAR_FLING_H_SPEED
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce  = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity  = Vector3.new(hx, CAR_FLING_V_SPEED, hz)
    bv.Parent    = targetHRP
    task.delay(CAR_BV_LIFETIME, function()
        if bv and bv.Parent then bv:Destroy() end
    end)
end

local function startCarFlingLoop(targetPlayer)
    getgenv().carBugEnabled = true
    task.spawn(function()
        local myChar, myHRP, targetChar, targetHRP, car, driveSeat

        while getgenv().carBugEnabled do
            task.wait(CAR_FLING_INTERVAL)

            -- refresh references each cycle — characters respawn
            myChar = LocalPlayer.Character
            myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myChar or not myHRP then continue end

            -- validate target still in server
            local tp = Players:FindFirstChild(targetPlayer)
            if not tp then
                if AddLog then AddLog("warn","Car Fling: target left the server") end
                getgenv().carBugEnabled = false
                if actionRowRefs.carFlingToggleCb then actionRowRefs.carFlingToggleCb(false) end
                break
            end

            targetChar = tp.Character
            targetHRP  = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
            if not targetChar or not targetHRP then continue end

            -- find a car
            car = findBestCar(targetHRP)
            if not car then continue end

            driveSeat = car:FindFirstChild("DriveSeat")
            if not driveSeat or driveSeat.Occupant then continue end

            -- ensure primary part set
            if not car.PrimaryPart then
                car.PrimaryPart =
                    (car:FindFirstChild("Body") and car:FindFirstChild("Body"):FindFirstChild("#Weight"))
                    or car:FindFirstChildOfClass("BasePart")
            end
            if not car.PrimaryPart then continue end

            -- sit LocalPlayer if needed to unlock car, then bail immediately
            local myHum = myChar:FindFirstChildOfClass("Humanoid")
            if myHum and not driveSeat.Occupant then
                local usable = car:GetAttribute("Usable")
                if usable == false then
                    pcall(function() driveSeat:Sit(myHum) end)
                    car:SetAttribute("Usable", true)
                    task.wait(0.12)
                    pcall(function()
                        myHum:ChangeState(Enum.HumanoidStateType.Jumping)
                        myHum.Jump = true
                        myHum.Sit  = false
                    end)
                    task.wait(0.08)
                end
            end

            -- teleport car onto target then immediately launch
            task.wait()  -- yield so physics settles one tick
            local freshTarget = Players:FindFirstChild(targetPlayer)
            if not freshTarget or not freshTarget.Character then continue end
            local freshHRP = freshTarget.Character:FindFirstChild("HumanoidRootPart")
            if not freshHRP then continue end

            pcall(function()
                car:SetPrimaryPartCFrame(freshHRP.CFrame + Vector3.new(0, 0.5, 0))
            end)

            -- double-tap: two velocity pulses in quick succession for reliability
            pcall(function() launchFling(freshHRP) end)
            task.wait(0.04)
            local stillHRP = freshTarget.Character and freshTarget.Character:FindFirstChild("HumanoidRootPart")
            if stillHRP then
                pcall(function() launchFling(stillHRP) end)
            end

            carFlingHits += 1
            if AddLog then AddLog("ok","Car fling hit #"..carFlingHits.." → "..targetPlayer) end
            if actionRowRefs.carFlingHitLabel then
                actionRowRefs.carFlingHitLabel.Text = "HITS: "..carFlingHits
            end
        end
    end)
end

local function stopCarFling()
    getgenv().carBugEnabled = false
end

